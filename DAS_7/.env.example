# DAS 7 backend — copy to .env and fill in. 

# Runtime settings
# development | test | production
NODE_ENV=development
PORT=4000

# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_SCHEMA=insight
SUPABASE_JWKS_URL=

# Seed script
# Existing Supabase Auth user linked to the primary demo parent.
SEED_AUTH_USER_ID=

# LLM
# stub | openrouter   ('stub' needs no API key and never calls the network)
# anthropic | openai | gemini are accepted values but have no adapter yet.
LLM_PROVIDER=stub
LLM_API_KEY=
# openrouter model id
LLM_MODEL=
# Raise this for openrouter — it adds a routing hop and free models can queue.
LLM_TIMEOUT_MS=10000

# Email service
# brevo | fake  ('fake' records emails in memory instead of sending)
EMAIL_PROVIDER=fake
BREVO_API_KEY=
# Sender address, must be verified in Brevo -> Senders & IPs -> Senders.
EMAIL_FROM=

# Notification scheduler
SCHEDULER_ENABLED=false
SCHEDULER_TICK_MS=900000
NOTIFY_WEEKLY_MS=604800000
NOTIFY_FORTNIGHTLY_MS=1209600000
NOTIFY_MONTHLY_MS=2592000000

# Integration testing
SUPABASE_ANON_KEY=
TEST_SUPABASE_REF=
TEST_USER_A_EMAIL=
TEST_USER_A_PASSWORD=
TEST_USER_B_EMAIL=
TEST_USER_B_PASSWORD=
