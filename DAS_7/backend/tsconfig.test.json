{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "module": "CommonJS",
        "moduleResolution": "Node",
        "rootDir": ".",
        "outDir": ".ts-jest",
        "types": ["jest", "node"],
        "ignoreDeprecations": "6.0",
        "noEmit": false,
        "declaration": false,
        "declarationMap": false
    },
    "include": ["src/**/*.ts", "src/**/*.d.ts", "test/**/*.ts"],
    "exclude": ["dist", "node_modules", "coverage"]
}
