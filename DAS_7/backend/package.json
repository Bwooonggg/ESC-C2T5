{
    "name": "das7-backend",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "description": "DAS 7 TypeScript backend scaffold",
    "engines": {
        "node": ">=20"
    },
    "scripts": {
        "dev": "tsx watch src/entrypoints/api.ts",
        "dev:worker": "tsx watch src/entrypoints/worker.ts",
        "build": "tsc -p tsconfig.build.json",
        "migrate": "tsx src/entrypoints/migrate.ts",
        "migrate:compiled": "node dist/entrypoints/migrate.js",
        "start": "node dist/entrypoints/api.js",
        "start:worker": "node dist/entrypoints/worker.js",
        "supabase:version": "supabase --version",
        "supabase:link": "supabase link",
        "supabase:db:push:dry-run": "supabase db push --linked --dry-run",
        "supabase:db:push": "supabase db push --linked",
        "supabase:migrations": "supabase migration list --linked",
        "supabase:types": "supabase gen types --linked --lang typescript --schema insight > src/infrastructure/supabase/generated/database.types.ts",
        "typecheck": "tsc --noEmit -p tsconfig.json",
        "test": "jest",
        "test:watch": "jest --watch",
        "test:coverage": "jest --coverage",
        "test:unit": "jest test/unit",
        "test:http": "jest test/http",
        "test:integration": "jest --config jest.integration.config.cjs --runInBand",
        "test:contract": "jest test/contract",
        "test:e2e": "jest test/e2e --runInBand"
    },
    "dependencies": {
        "@supabase/supabase-js": "2.110.8",
        "dotenv": "^17.4.2",
        "express": "^4.21.2",
        "mysql2": "^3.23.1",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@types/express": "^4.17.21",
        "@types/jest": "^30.0.0",
        "@types/node": "^24.13.2",
        "@types/supertest": "^7.2.1",
        "jest": "^30.4.2",
        "supabase": "2.109.1",
        "supertest": "^7.2.2",
        "ts-jest": "^29.4.11",
        "tsx": "^4.19.2",
        "typescript": "~6.0.2"
    },
    "allowScripts": {
        "esbuild@0.28.1": true,
        "unrs-resolver@1.12.2": true
    }
}
