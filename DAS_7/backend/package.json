{
    "name": "das7-backend",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "description": "DAS 7 TypeScript backend scaffold",
    "engines": {
        "node": ">=20"
    },
    "scripts": {
        "dev": "tsx watch src/entrypoints/api.ts",
        "dev:worker": "tsx watch src/entrypoints/worker.ts",
        "build": "tsc -p tsconfig.build.json",
        "start": "node dist/entrypoints/api.js",
        "start:worker": "node dist/entrypoints/worker.js",
        "typecheck": "tsc --noEmit -p tsconfig.json",
        "test": "jest",
        "test:watch": "jest --watch",
        "test:coverage": "jest --coverage",
        "test:unit": "jest test/unit",
        "test:http": "jest test/http",
        "test:integration": "jest test/integration --runInBand",
        "test:contract": "jest test/contract",
        "test:e2e": "jest test/e2e --runInBand"
    },
    "dependencies": {
        "cors": "^2.8.5",
        "express": "^4.21.2"
    },
    "devDependencies": {
        "@types/cors": "^2.8.17",
        "@types/express": "^4.17.21",
        "@types/jest": "^30.0.0",
        "@types/node": "^24.13.2",
        "@types/supertest": "^7.2.1",
        "jest": "^30.4.2",
        "supertest": "^7.2.2",
        "ts-jest": "^29.4.11",
        "tsx": "^4.19.2",
        "typescript": "~6.0.2"
    }
}
