# DAS 7 backend — copy to .env and fill in. Never commit the real .env.

# --- Runtime -----------------------------------------------------------------
# development | test | production
NODE_ENV=development
PORT=4000

# --- Supabase ----------------------------------------------------------------
# REQUIRED. Project URL, e.g. https://abcdefghijklmnop.supabase.co
SUPABASE_URL=
# REQUIRED. Server-only secret — bypasses RLS. Never commit, never send to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Postgres schema holding the DAS 7 tables.
SUPABASE_DB_SCHEMA=insight
# Leave blank to derive it as ${SUPABASE_URL}/auth/v1/.well-known/jwks.json
SUPABASE_JWKS_URL=
# Leave blank unless the project still issues legacy HS256 access tokens.
SUPABASE_JWT_SECRET=

# --- Auth --------------------------------------------------------------------
# Dev-only escape hatch: auth user id used when a request carries no Authorization
# header. Ignored when NODE_ENV=production. Leave blank to always require a token.
AUTH_DEV_SUB=

# --- Seed script (npm run seed) ----------------------------------------------
# Auth user id to link the seeded demo parent to. Leave blank and the parent is
# seeded with auth_user_id = null, which means no login — and no token, and no
# AUTH_DEV_SUB fallback — can reach it. Normally set this to the same value as
# AUTH_DEV_SUB above, then re-run the seed.
#
# Use a THIRD auth user here — not TEST_USER_A or TEST_USER_B below. The
# integration harness creates and deletes a parent row for each of those two on
# every run, and insight.parents.auth_user_id is UNIQUE. If the harness finds one
# of their ids mapped to a parent it did not create, it refuses to run rather
# than delete the row. Only the demo user's id is needed here; no password, since
# nothing in the backend signs it in.
SEED_AUTH_USER_ID=

# --- LLM ---------------------------------------------------------------------
# stub | anthropic | openai | gemini  ('stub' needs no API key)
LLM_PROVIDER=stub
LLM_API_KEY=
# Provider-specific model id; blank uses the adapter's default.
LLM_MODEL=
LLM_TIMEOUT_MS=10000

# --- Email -------------------------------------------------------------------
# resend | fake  ('fake' records emails in memory instead of sending)
EMAIL_PROVIDER=fake
RESEND_API_KEY=
# Verified sender address, e.g. DAS Insights <insights@example.org>
EMAIL_FROM=

# --- Notification scheduler --------------------------------------------------
SCHEDULER_ENABLED=false
# How often the scheduler wakes up to look for due notifications (15 min).
SCHEDULER_TICK_MS=900000
# Minimum gap between emails per frequency. Defaults shown; shrink them for demos.
NOTIFY_WEEKLY_MS=604800000
NOTIFY_FORTNIGHTLY_MS=1209600000
NOTIFY_MONTHLY_MS=2592000000

# --- Integration tests only --------------------------------------------------
# Integration suites self-skip unless SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY and
# TEST_SUPABASE_REF are all set AND SUPABASE_URL contains TEST_SUPABASE_REF —
# a guard against pointing the tests at the wrong project.
SUPABASE_ANON_KEY=
TEST_SUPABASE_REF=
TEST_USER_A_EMAIL=
TEST_USER_A_PASSWORD=
TEST_USER_B_EMAIL=
TEST_USER_B_PASSWORD=
