NODE_ENV=development
PORT=4000

# Reserved for the MySQL integration.
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=das7
MYSQL_USER=das7
MYSQL_PASSWORD=change-me

# Hosted Supabase development project. Keep production values out of local env files.
SUPABASE_URL=https://<dev-project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=
# Worker-only secret key; never expose this to a browser or commit it.
SUPABASE_SECRET_KEY=
SUPABASE_SCHEMA=insight

# Reserved for external generator and email integrations.
SUMMARY_GENERATOR_URL=
RECOMMENDATION_GENERATOR_URL=
SUMMARY_GENERATOR_API_KEY=
RECOMMENDATION_GENERATOR_API_KEY=
SUMMARY_GENERATOR_TIMEOUT_MS=10000
RECOMMENDATION_GENERATOR_TIMEOUT_MS=10000
EMAIL_PROVIDER_URL=
EMAIL_PROVIDER_API_KEY=

# Reserved for scheduled worker configuration.
WORKER_ENABLED=false
WORKER_POLL_INTERVAL_MS=60000
NOTIFICATION_TIMEZONE=Asia/Singapore
