NODE_ENV=development
PORT=4000

# Reserved for the MySQL integration.
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=das7
MYSQL_USER=das7
MYSQL_PASSWORD=change-me

# Hosted Supabase development project. Keep production values out of local env files.
SUPABASE_URL=https://<dev-project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=
# Worker-only secret key; never expose this to a browser or commit it.
SUPABASE_SECRET_KEY=
SUPABASE_SCHEMA=insight

# One provider-neutral LLM boundary shared by summaries and recommendations.
# Leave these blank until the provider is selected in Phase 10; generation then
# fails fast as unavailable instead of contacting a vendor.
LLM_PROVIDER=
LLM_API_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_MS=10000

# Reserved for the email integration.
EMAIL_PROVIDER_URL=
EMAIL_PROVIDER_API_KEY=

# Reserved for scheduled worker configuration.
WORKER_ENABLED=false
WORKER_POLL_INTERVAL_MS=60000
NOTIFICATION_TIMEZONE=Asia/Singapore
