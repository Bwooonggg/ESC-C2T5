@startuml
title Use Case DAS 7 - Notify Parent

hide footbox
skinparam backgroundColor white
skinparam shadowing false

actor Parent
actor Clock
participant EmailUpdatesUI as UI
participant NotificationController as Controller
participant Scheduler
participant NotifierService as Notifier
participant InsightService as Insight
participant SupabaseRepository as Repository
participant LLMAdapter as Adapter
actor Supabase as Database <<Secondary Actor>>
actor "LLM Provider" as LLM <<Secondary Actor>>
actor "Email Provider" as Email <<Secondary Actor>>

alt parent sends an update now
  Parent -> UI : sendUpdateNow()
  activate UI
  UI -> Controller : savePreferences(parentId, preferences)
  activate Controller
  Controller -> Repository : upsertPreference(preferences)
  activate Repository
  Repository -> Database : upsertPreference(preferences)
  activate Database
  Database --> Repository : NotificationPreference
  deactivate Database
  Repository --> Controller : NotificationPreference
  deactivate Repository
  Controller --> UI : NotificationPreference
  deactivate Controller
  UI -> Controller : notifyParent(parentId)
  activate Controller
  Controller -> Notifier : notifyParent(parentId, now)
  activate Notifier
else scheduled notification run
  Clock -> Scheduler : tick(now)
  activate Scheduler
  Scheduler -> Notifier : runDueNotifications(now)
  activate Notifier
  Notifier -> Repository : listEnabledPreferences()
  activate Repository
  Repository -> Database : selectEnabledPreferences()
  activate Database
  Database --> Repository : NotificationPreference[]
  deactivate Database
  Repository --> Notifier : NotificationPreference[]
  deactivate Repository
  loop each enabled preference
    Notifier -> Repository : getLastSentAt(parentId)
    activate Repository
    Repository -> Database : selectLastSentAt(parentId)
    activate Database
    Database --> Repository : sentAt or null
    deactivate Database
    Repository --> Notifier : sentAt or null
    deactivate Repository
    Notifier -> Notifier : isDue(sentAt, frequency, now)
    activate Notifier
    Notifier --> Notifier : true or false
    deactivate Notifier
  end
end

Notifier -> Repository : getNotificationData(parentId)
activate Repository
Repository -> Database : selectParentPreferenceAndStudents(parentId)
activate Database
Database --> Repository : Parent, Preference, Student[]
deactivate Database
Repository --> Notifier : Parent, Preference, Student[]
deactivate Repository

alt notification can be prepared
  loop each linked student
    Notifier -> Insight : getSummary(studentId)
    activate Insight
    Insight -> Repository : getProgressAndSummary(studentId)
    activate Repository
    Repository -> Database : selectProgressAndLatestSummary(studentId)
    activate Database
    Database --> Repository : ProgressRecord[], Summary or null
    deactivate Database
    Repository --> Insight : ProgressRecord[], Summary or null
    deactivate Repository

    opt summary is missing or stale
      Insight -> Adapter : generateSummary(student, records)
      activate Adapter
      Adapter -> LLM : generateSummary(progress)
      activate LLM
      LLM --> Adapter : summary
      deactivate LLM
      Adapter --> Insight : summary
      deactivate Adapter
      Insight -> Repository : saveSummary(studentId, summary)
      activate Repository
      Repository -> Database : insertSummary(studentId, summary)
      activate Database
      Database --> Repository : Summary
      deactivate Database
      Repository --> Insight : Summary
      deactivate Repository
    end

    Insight --> Notifier : Summary
    deactivate Insight
  end

  Notifier -> Email : sendEmail(recipientEmail, subject, body)
  activate Email
  Email --> Notifier : sent
  deactivate Email
  Notifier -> Repository : saveNotification(parentId, email)
  activate Repository
  Repository -> Database : insertEmailNotification(parentId, email)
  activate Database
  Database --> Repository : notificationRecorded()
  deactivate Database
  Repository --> Notifier : notificationRecorded()
  deactivate Repository

  alt parent initiated the notification
    Notifier --> Controller : parentNotified()
    deactivate Notifier
    Controller --> UI : parentNotified()
    deactivate Controller
    UI --> Parent : displaySentConfirmation()
    deactivate UI
  else scheduler initiated the notification
    Notifier --> Scheduler : parentNotified()
    deactivate Notifier
    Scheduler --> Clock : notificationRunComplete()
    deactivate Scheduler
  end
else notification cannot be prepared
  alt parent initiated the notification
    Notifier --> Controller : notificationFailed()
    deactivate Notifier
    Controller --> UI : notificationFailed()
    deactivate Controller
    UI --> Parent : displayTryAgainMessage()
    deactivate UI
  else scheduler initiated the notification
    Notifier --> Scheduler : notificationFailed()
    deactivate Notifier
    Scheduler --> Clock : notificationRunComplete()
    deactivate Scheduler
  end
end

@enduml
