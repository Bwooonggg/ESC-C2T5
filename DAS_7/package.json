{
    "name": "das7-backend",
    "version": "1.0.0",
    "description": "DAS 7 Parent Insight Dashboard backend — Express API + email scheduler",
    "private": true,
    "type": "module",
    "main": "dist/index.js",
    "scripts": {
        "dev": "tsx watch src/index.ts",
        "build": "tsc -p tsconfig.build.json",
        "start": "node dist/index.js",
        "typecheck": "tsc --noEmit",
        "test": "cross-env NODE_OPTIONS=--experimental-vm-modules jest",
        "seed": "tsx scripts/seed.ts"
    },
    "dependencies": {
        "@supabase/supabase-js": "^2.58.0",
        "dotenv": "^17.2.3",
        "express": "^5.1.0",
        "jose": "^6.1.0"
    },
    "devDependencies": {
        "@types/express": "^5.0.3",
        "@types/jest": "^30.0.0",
        "@types/node": "^24.6.2",
        "@types/supertest": "^6.0.3",
        "cross-env": "^10.1.0",
        "jest": "^30.2.0",
        "supertest": "^7.1.4",
        "ts-jest": "^29.4.4",
        "tsx": "^4.20.6",
        "typescript": "^5.9.3"
    }
}
