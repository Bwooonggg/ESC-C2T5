{
  "compilerOptions": {
    "target": "ES2023",
    "module": "CommonJS",
    "moduleResolution": "Bundler",
    "esModuleInterop": true,
    "types": ["jest", "node"],
    "skipLibCheck": true,
    "strict": true,

    // ts-jest transforms in memory and never reads emitted output, so there is
    // nothing to emit. Without this, `tsc -p tsconfig.test.json` writes .js
    // files next to every .ts source (no outDir is set), and jest then
    // discovers both copies and runs every suite twice.
    "noEmit": true
  },
  "include": ["src/**/*.ts", "test/**/*.ts"]
}
