# DAS 1 backend — copy to .env and replace placeholders. Never commit .env.

# Required server-side keys. Despite its legacy VITE_ prefix, this Anthropic key
# is consumed only by the DAS 1 Node backend.
VITE_ANTHROPIC_API_KEY=
SUPA_URL=https://your-project.supabase.co
SUPA_SECRET_KEY=

# Optional runtime overrides.
PORT=4173
ANTHROPIC_MODEL=claude-sonnet-5
