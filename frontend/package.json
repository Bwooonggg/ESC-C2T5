{
  "name": "dial-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
  "dev": "vite",
  "build": "tsc -b && vite build",
  "preview": "vite preview",
  "lint": "echo \"no linter configured yet\"",
  "test": "jest",
  "test:ui:das7": "cross-env DAS7_UI_HEADED=false node --test --test-timeout=60000 test/ui/das7/das7-ui.spec.js",
  "test:ui:das7:headed": "cross-env DAS7_UI_HEADED=true node --test --test-timeout=60000 test/ui/das7/das7-ui.spec.js",
  "test:ui:das1": "cross-env DAS1_UI_HEADED=false node --test --test-timeout=60000 test/ui/das1/das1-ui.spec.js",
  "test:ui:das1:headed": "cross-env DAS1_UI_HEADED=true node --test --test-timeout=60000 test/ui/das1/das1-ui.spec.js",
  "test:ui:das3": "cross-env DAS3_UI_HEADED=false node --test --test-timeout=60000 test/ui/das3/das3-ui.spec.js",
  "test:ui:das3:headed": "cross-env DAS3_UI_HEADED=true node --test --test-timeout=60000 test/ui/das3/das3-ui.spec.js",
  "test:e2e": "playwright test",
  "test:e2e:headed": "playwright test --headed",
  "test:e2e:ui": "playwright test --ui"
},
  "dependencies": {
    "@langchain/langgraph-sdk": "^1.9.28",
    "@supabase/supabase-js": "^2.110.8",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.11.0",
    "recharts": "^2.15.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.5.0",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "cross-env": "^10.1.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "selenium-webdriver": "^4.47.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.8.0",
    "vite": "^6.0.0"
  }
}
